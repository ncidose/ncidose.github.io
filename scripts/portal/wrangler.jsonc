{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "ncidosetools-portal-api",
  "main": "worker.js",
  "compatibility_date": "2026-08-01",
  "workers_dev": true,
  "routes": [
    {
      "pattern": "portal.ncidosetools.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "../../dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "vars": {
    "ENVIRONMENT": "production",
    "ACCESS_TEAM_DOMAIN": "wild-lab-6e97.cloudflareaccess.com",
    "ACCESS_AUD": "d2f0c8b27d7f5c5e69445455354cfe733db79f884fca6aa4d05db7c5ffd70834",
    "ALLOWED_ORIGINS": "https://ncidose.github.io,https://portal.ncidosetools.com,http://127.0.0.1:8084"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ncidosetools-portal",
      "database_id": "8894e79d-efd5-4598-8f04-0dc83191b2fc"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "ncidosetools"
    }
  ]
}
